{
  "name": "odot-dashboard",
  "productName": "ODOT Dashboard",
  "version": "1.0.0",
  "description": "ODOT camera dashboard turned into a desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "test": "vitest run",
    "test:python": "python -m compileall -q run_server.py && python -m unittest discover -s tests -p test_*.py",
    "package": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "24.13.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.odot.dashboard",
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/**/*",
      "!src/**/*",
      "!tests/**/*",
      "!vite.config.js",
      "!package-lock.json",
      "!project.json",
      "!.github/**/*",
      "!Dockerfile",
      "!docker-compose.yml",
      "!*.py",
      "!.qa-tmp/**/*",
      "!.env*",
      "!__pycache__/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    }
  }
}
